    instruction: "Add ATS platform cell with color coded badge in table row"
    replacement_infos {
      original_chunk {
        target_content: "                    <td className=\"py-3 px-3 font-bold text-slate-200\">\n                      {job.companyName}\n                    </td>\n                    <td className=\"py-3 px-3 text-slate-300 font-medium\">"
