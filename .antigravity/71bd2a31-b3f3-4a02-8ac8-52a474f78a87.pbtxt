        }
        lines {
          text: "    const link = document.createElement(\'a\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    link.setAttribute(\'href\', url);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    link.setAttribute(\'download\', `shreyathakur9294_Candidates_Jobs_${getCurrentDayMonthYear().replace(/\\//g, \'-\')}.csv`);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    document.body.appendChild(link);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    link.click();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
