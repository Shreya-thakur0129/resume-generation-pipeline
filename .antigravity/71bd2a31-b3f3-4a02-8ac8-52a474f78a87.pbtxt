          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: " * Builds the comprehensive, enhanced prompt to give to Gemini (or another AI)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: " * with the Candidate\'s exact rules, master LaTeX, and Job Description."
