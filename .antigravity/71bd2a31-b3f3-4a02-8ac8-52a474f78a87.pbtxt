    }
    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "71bd2a31-b3f3-4a02-8ac8-52a474f78a87"
    source_trajectory_step_info {
      trajectory_id: "71bd2a31-b3f3-4a02-8ac8-52a474f78a87"
      step_index: 153
      metadata_index: 338
      cascade_id: "71bd2a31-b3f3-4a02-8ac8-52a474f78a87"
