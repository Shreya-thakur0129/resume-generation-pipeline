        target_content: "  const [selectedCandidateId, setSelectedCandidateId] = useState<string>(CANDIDATES[0].id);\n  const [jobsLimit, setJobsLimit] = useState<number>(JOBS_TO_FETCH);\n  const [candidateJobs, setCandidateJobs] = useState<Record<string, JobSearchResult[]>>({\n    \'lohith-s\': searchJobsForCandidate(CANDIDATES[0], 75),\n    \'smit-patel\': searchJobsForCandidate(CANDIDATES[1], 75),\n    \'vamsi-krishna\': searchJobsForCandidate(CANDIDATES[2], 75),\n  });"
        replacement_content: "  const [selectedCandidateId, setSelectedCandidateId] = useState<string>(CANDIDATES[0].id);\n  const [jobsLimit, setJobsLimit] = useState<number>(JOBS_TO_FETCH);\n  const [candidateJobs, setCandidateJobs] = useState<Record<string, JobSearchResult[]>>(() => {\n    const initMap: Record<string, JobSearchResult[]> = {};\n    for (const c of CANDIDATES) {\n      initMap[c.id] = searchJobsForCandidate(c, c.maxTotalJobs || 75);\n    }\n    return initMap;\n  });"
      }
