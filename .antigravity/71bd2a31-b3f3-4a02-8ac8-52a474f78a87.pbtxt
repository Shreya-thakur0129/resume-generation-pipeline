 \'\342\200\224\'}</div>\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono text-slate-500 uppercase\">Location</span>\n              <div className=\"text-slate-200 font-medium\">{candidate.location || \'\342\200\224\'}</div>\n            </div>\n            <div>\n              <span className=\"text-[10px] font-mono text-slate-500 uppercase\">Status</span>\n              <div className=\"text-cyan-400 font-medium\">{candidate.status || \'READY\'}</div>\n            </div>\n          </div>\n\n          {/* Professional Summary */}\n          {candidate.summary && (\n            <div>\n              <h4 className=\"text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n                <User className=\"w-3.5 h-3.5\" /> Professional Summary\n              </h4>\n              <p className=\"bg-slate-900/80 p-3 rounded-xl border border-slate-850 leading-relaxed text-slate-300\">\n                {candidate.summary}\n              </p>\n            </div>\n          )}\n\n          {/* Skills */}\n          {candidate.skills && (\n            <div>\n              <h4 className=\"text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n                <FileCode2 className=\"w-3.5 h-3.5\" /> Technical Skills\n              </h4>\n              <pre className=\"bg-slate-900/80 p-3 rounded-xl border border-slate-850 font-mono text-[11px] text-slate-300 whitespace-pre-wrap leading-relaxed\">\n                {candidate.skills}\n              </pre>\n            </div>\n          )}\n\n          {/* Experience */}\n          {candidate.experience && (\n            <div>\n              <h4 className=\"text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n                <Briefcase className=\"w-3.5 h-3.5\" /> Work Experience\n              </h4>\n              <pre className=\"bg-slate-900/80 p-3 rounded-xl border border-slate-850 font-mono text-[11px] text-slate-300 whitespace-pre-wrap leading-relaxed\">\n                {candidate.experience}\n              </pre>\n            </div>\n          )}\n\n          {/* Projects */}\n          {candidate.projects && (\n            <div>\n              <h4 className=\"text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n                <FileCode2 className=\"w-3.5 h-3.5\" /> Key Projects\n              </h4>\n              <pre className=\"bg-slate-900/80 p-3 rounded-xl border border-slate-850 font-mono text-[11px] text-slate-300 whitespace-pre-wrap leading-relaxed\">\n                {candidate.projects}\n              </pre>\n            </div>\n          )}\n\n          {/* Education */}\n          {candidate.education && (\n            <div>\n              <h4 className=\"text-[11px] font-mono font-bold text-cyan-400 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n                <GraduationCap className=\"w-3.5 h-3.5\" /> Education\n              </h4>\n              <pre className=\"bg-slate-900/80 p-3 rounded-xl border border-slate-850 font-mono text-[11px] text-slate-300 whitespace-pre-wrap leading-relaxed\">\n                {candidate.education}\n              </pre>\n            </div>\n          )}\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"bg-slate-900 px-5 py-3 border-t border-slate-800 flex items-center justify-between\">\n          <button\n            type=\"button\"\n            onClick={onClose}\n            className=\"px-4 py-1.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white transition-colors\"\n          >\n            Close\n          </button>\n          <button\n            type=\"button\"\n            id=\"modal-run-candidate-btn\"\n            onClick={() => {\n              onClose();\n              onRunCandidate(candidate);\n            }}\n            dis