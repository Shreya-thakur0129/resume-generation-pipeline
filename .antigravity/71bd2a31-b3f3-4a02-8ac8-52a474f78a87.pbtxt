  user_input {
    user_response: "import asyncio\nimport os\nimport glob\nimport sys\nimport pandas as pd\nimport urllib.parse\nfrom playwright.async_api import async_playwright\nfrom datetime import datetime\nimport re\nimport argparse\nimport json\n\n# Force UTF-8 encoding for standard streams to prevent UnicodeEncodeError when printing emojis on Windows\nfor stream in (sys.stdout, sys.stderr):\n    if stream and hasattr(stream, \'reconfigure\'):\n        try:\n            stream.reconfigure(encoding=\'utf-8\', errors=\'replace\')\n        except Exception:\n            pass\n\n# ==================== ARGUMENT PARSING ====================\nparser = argparse.ArgumentParser(description=\"Config-Driven LinkedIn Jobs Scraper Bot\")\nparser.add_argument(\"--candidate\", type=str, required=True, help=\"Candidate name from profiles.json (e.g. Vinay, Sumit, Shiva)\")\nparser.add_argument(\"--workday\", type=int, default=None, help=\"Override Max Workday Jobs limit\")\nparser.add_argument(\"--easy\", type=int, default=None, help=\"Override Max Easy Apply ATS Jobs limit\")\nparser.add_argument(\"--scrape-only\", action=\"store_true\", help=\"Scrape jobs and write output Excel file without starting the resume customizer\")\nargs, unknown = parser.parse_known_args()\n\nCANDIDATE_NAME = args.candidate.strip()\n\n# Load profiles.json configuration\nCONFIG_PATH = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"profiles.json\")\nif not os.path.exists(CONFIG_PATH):\n    print(f\"\342\235\214 Error: Central configuration file profiles.json not found at: {CONFIG_PATH}\")\n    sys.exit(1)\n\nwith open(CONFIG_PATH, \'r\', encoding=\'utf-8\') as f:\n    PROFILES = json.load(f)\n\nif CANDIDATE_NAME not in PROFILES:\n    print(f\"\342\235\214 Error: Candidate \'{CANDIDATE_NAME}\' not found in profiles.json. Available candidates: {list(PROFILES.keys())}\")\n    sys.exit(1)\n\nCANDIDATE_CONFIG = PROFILES[CANDIDATE_NAME]\n\n# ==================== CONFIGURATION ====================\nWINDOWS_USERNAME = os.environ.get(\"USERNAME\", \"shrey\")\nOUTPUT_FOLDER = rf\"C:\\Users\\{WINDOWS_USERNAME}\\Documents\\LinkedIn_Jobs\"\n\n# Resolve limits from arguments or config file\nMAX_WORKDAY_JOBS = args.workday if args.workday is not None else CANDIDATE_CONFIG.get(\"max_workday_jobs\", 10)\nMAX_EASY_ATS_JOBS = args.easy if args.easy is not None else CANDIDATE_CONFIG.get(\"max_easy_ats_jobs\", 65)\nMAX_TOTAL_JOBS = MAX_WORKDAY_JOBS + MAX_EASY_ATS_JOBS\n\nJOB_TITLES = CANDIDATE_CONFIG.get(\"search_keywords\", [])\nBOT_PROFILE_DIR = CANDIDATE_CONFIG.get(\"linkedin_profile\")\n\n# \360\237\232\253 BLACKLISTED COMPANIES (Instantly Skipped for Speed)\nBLOCKED_COMPANIES = [\n    \"pinnacle\", \"google\", \"dice\", \"tcs\", \"tata consultancy\", \"ladder\", \"jobright\",\n    \"netrolynx\", \"jack & jill\", \"jack and jill\", \"chatgpt\", \"openai\", \"microsoft\",\n    \"fetchojobs\", \"fetch\", \"sundayy\", \"accenture\", \"deloitte\", \"dataannotation\",\n    \"haystack\", \"hackajob\", \"accenture federal services\"\n]\n\n# \360\237\225\222 f_TPR=r43200 sets searching strictly to the past 12 hours\nBASE_URL = \"https://www.linkedin.com/jobs/search/?f_TPR=r43200&f_JT=F&location=United%20States&keywords={keyword}&sortBy=DD&start={start_offset}\"\n\n# =======================================================\n# ATS PLATFORM DETECTOR\n# =======================================================\ndef classify_ats_url(url: str, page_content: str = \"\") -> str:\n    url_lower = url.lower()\n    content_lower = page_content.lower()\n\n    workday_patterns = [\"myworkdayjobs.com\", \"workday.com\", \"wd1.myworkdayjobs\", \"wd3.myworkdayjobs\", \"wd5.myworkdayjobs\", \"workday\"]\n    if any(p in url_lower for p in workday_patterns) or \"myworkdayjobs\" in content_lower:\n        return \"WORKDAY\"\n\n    if any(p in url_lower for p in [\"greenhouse.io\", \"gh_jid=\", \"gh_src=\"]) or \"grnhse_app\" in content_lower:\n        return \"EASY_ATS (Greenhouse)\"\n    if \"ashbyhq.com\" in url_lower or \"ashby-job-posting\" in content_lower:\n        return \"EASY_ATS (Ashby)\"\n    if \"lever.co\" in url_lower or \"lever-job-posting\" in content_lower:\n        return \"EASY_ATS (Lever)\"\n    if any(p in url_lower for p in [\"craft.co\", \"craftweave\"]):\n        return \"EASY_ATS (Craftweave)\"\n    if \"workable.com\" in url_lower:\n        return \"EASY_ATS (Workable)\"\n    if \"smartrecruiters.com\" in url_lower:\n        return \"EASY_ATS (SmartRecruiters)\"\n    if \"bamboohr.com\" in url_lower:\n        return \"EASY_ATS (BambooHR)\"\n\n    return \"EASY_ATS\"\n\n# =======================================================\n# WORKPLACE TYPE DETECTOR\n# =======================================================\nasync def detect_workplace_type(page, card_text: str) -> str:\n    card_lower = card_text.lower()\n    try:\n        wp_loc = page.locator(\".jobs-unified-top-card__workplace-type, .jobs-description-style__workplace-type\")\n        if await wp_loc.count() > 0:\n            text = (await wp_loc.first.inner_text()).strip()\n            if text:\n                text_lower = text.lower()\n                if \"remote\" in text_lower:\n                    return \"Remote\"\n                elif \"hybrid\" in text_lower:\n                    return \"Hybrid\"\n                elif \"on-site\" in text_lower or \"onsite\" in text_lower:\n                    return \"On-site\"\n                return text\n    except Exception:\n        pass\n\n    if \"remote\" in card_lower:\n        return \"Remote\"\n    elif \"hybrid\" in card_lower:\n        return \"Hybrid\"\n    elif \"on-site\" in card_lower or \"onsite\" in card_lower:\n        return \"On-site\"\n    return \"On-site\"\n\ndef is_posted_time_within_12_hours(time_str: str) -> bool:\n    time_str = time_str.lower().strip()\n    if not time_str:\n        return True\n    if \"yesterday\" in time_str:\n        return False\n    match = re.search(r\'(\\d+)\\s*([a-z]+)\', time_str)\n    if match:\n        value = int(match.group(1))\n        unit = match.group(2)\n        if unit in [\"m\", \"min\", \"minute\", \"minutes\"]:\n            return True\n        if unit in [\"h\", \"hr\", \"hrs\", \"hour\", \"hours\"]:\n            return value <= 12\n        if unit in [\"d\", \"day\", \"days\", \"w\", \"wk\", \"week\", \"weeks\", \"mo\", \"month\", \"months\", \"y\", \"yr\", \"year\", \"years\"]:\n            return False\n    if any(k in time_str for k in [\"day\", \"week\", \"month\", \"year\", \"yesterday\"]):\n        return False\n    return True\n\nasync def resolve_external_apply_url(context, page, link_loc) -> str:\n    final_url = \"\"\n    try:\n        apply_btn = page.locator(\"button.jobs-apply-button, a.jobs-apply-button, button[data-job-id]\")\n        if await apply_btn.count() > 0:\n            btn_text = await apply_btn.first.inner_text()\n            if \"easy apply\" in btn_text.lower():\n                return \"\"\n            new_page = None\n            try:\n                async with context.expect_page(timeout=4000) as page_info:\n                    await apply_btn.first.click()\n                new_page = await page_info.value\n            except Exception:\n                modal_selectors = [\n                    \"div[role=\'dialog\'] button:has-text(\'Continue\')\",\n                    \"div[role=\'dialog\'] a:has-text(\'Continue\')\",\n                    \"div[role=\'dialog\'] button:has-text(\'Apply\')\",\n                    \"button:has-text(\'Continue\')\",\n                    \"button:has-text(\'Go to website\')\",\n                    \".jobs-apply-button--modal\"\n                ]\n                for selector in modal_selectors:\n                    modal_btn = page.locator(selector)\n                    if await modal_btn.count() > 0 and await modal_btn.first.is_visible():\n                        try:\n                            async with context.expect_page(timeout=6000) as page_info2:\n                                await modal_btn.first.click()\n                            new_page = await page_info2.value\n                            break\n                        except Exception:\n                            pass\n\n            if new_page:\n                await new_page.wait_for_load_state(\"domcontentloaded\", timeout=12000)\n                await new_page.wait_for_timeout(2000)\n                final_url = new_page.url\n                await new_page.close()\n    except Exception as e:\n        print(f\"   \342\232\240\357\270\217 Error resolving external URL: {e}\")\n\n    if not final_url:\n        try:\n            href = await link_loc.first.get_attribute(\"href\")\n            if href:\n                final_url = f\"https://www.linkedin.com{href.split(\'?\')[0]}\" if href.startswith(\"/\") else href.split(\"?\")[0]\n        except Exception:\n            pass\n\n    return final_url\n\nasync def scrape_linkedin_jobs():\n    # If scraping is disabled for this candidate (e.g. Sumit reads Vinay\'s output)\n    if not CANDIDATE_CONFIG.get(\"scraping_enabled\", True):\n        scraped_source = CANDIDATE_CONFIG.get(\"read_scraped_from\")\n        print(f\"\342\204\271\357\270\217 Scraping disabled for \'{CANDIDATE_NAME}\'. Reading scraped jobs from \'{scraped_source}\' instead.\")\n        \n        # Directly launch tailoring\n        try:\n            from run_tailor import run_tailoring_pipeline\n            print(f\"\\n\360\237\232\200 Launching Resume Tailoring Pipeline directly for {CANDIDATE_NAME}...\")\n            await run_tailoring_pipeline(candidate=CANDIDATE_NAME)\n        except Exception as e:\n            print(f\"\342\235\214 Tailoring pipeline launch failed: {e}\")\n        return\n\n    if not os.path.exists(OUTPUT_FOLDER):\n        os.makedirs(OUTPUT_FOLDER)\n    if not os.path.exists(BOT_PROFILE_DIR):\n        os.makedirs(BOT_PROFILE_DIR)\n\n    async with async_playwright() as p:\n        print(f\"\360\237\232\200 Launching Scraper Bot for \'{CANDIDATE_NAME}\' (Target: {MAX_WORKDAY_JOBS} Workday + {MAX_EASY_ATS_JOBS} Easy ATS = {MAX_TOTAL_JOBS} total)...\")\n       \n        context = await p.chromium.launch_persistent_context(\n            user_data_dir=BOT_PROFILE_DIR,\n            channel=\"chrome\",\n            headless=False,  \n            slow_mo=150,\n            ignore_default_args=[\"--enable-automation\"],\n            args=[\"--disable-extensions\", \"--disable-blink-features=AutomationControlled\"]\n        )\n       \n        page = context.pages[0] if context.pages else await context.new_page()\n       \n        print(\"Checking login status...\")\n        try:\n            await page.goto(\"https://www.linkedin.com/\", timeout=60000, wait_until=\"domcontentloaded\")\n            await page.wait_for_timeout(1500)\n        except Exception as e:\n            print(f\"\342\235\214 Failed to load LinkedIn homepage. Error: {e}\")\n            await context.close()\n            return\n       \n        if \"feed\" not in page.url and \"mynetwork\" not in page.url:\n            print(\"\\n\" + \"=\"*60)\n            print(\"\360\237\233\221 FIRST TIME SETUP REQUIRED \360\237\233\221\")\n            print(f\"Please log into LinkedIn manually for profile \'{CANDIDATE_NAME}\'.\")\n            print(\"=\"*60 + \"\\n\")\n            try:\n                await page.wait_for_url(\"**/feed/**\", timeout=300000)\n                print(\"\342\234\205 Login successful!\")\n            except Exception:\n                print(\"\342\235\214 Did not detect login. Closing script.\")\n                await context.close()\n                return\n        else:\n            print(\"\342\234\205 Bot is logged in!\")\n\n        all_jobs = []\n        seen_links = set()\n        seen_companies = set()\n        \n        workday_count = 0\n        easy_ats_count = 0\n       \n        today_str = datetime.now().strftime(\'%Y-%m-%d\')\n        today_filename = f\"{CANDIDATE_NAME}_LinkedIn_Jobs_{today_str}.xlsx\"\n        \n        # Load from existing files for global duplicate checks\n        existing_xlsx = glob.glob(os.path.join(OUTPUT_FOLDER, \"*.xlsx\"))\n        existing_xlsx = [\n            f for f in existing_xlsx \n            if \"_with_jd\" not in f \n            and \"live_saved\" not in f \n            and not os.path.basename(f).startswith(\"~$\")\n        ]\n        \n        if existing_xlsx:\n            for xlsx_file in existing_xlsx:\n                file_name = os.path.basename(xlsx_file)\n                is_today = file_name == today_filename\n                try:\n                    df_existing = pd.read_excel(xlsx_file)\n                    excel_jobs = df_existing.to_dict(\'records\')\n                    for job in excel_jobs:\n                        link = str(job.get(\"Job URL\", job.get(\"Application Link\", \"\")))\n                        company = str(job.get(\"Company\", job.get(\"Company Name\", \"\"))).strip().lower()\n                        ats_type = str(job.get(\"Platform\", job.get(\"ATS Platform\", \"\")))\n                        \n                        if link and link not in seen_links:\n                            seen_links.add(link)\n                            if company:\n                                seen_companies.add(company)\n                            if is_today:\n                                normalized_job = {\n                                    \"Role\": job.get(\"Role\", job.get(\"Job Title\", \"\")),\n                                    \"Company\": job.get(\"Company\", job.get(\"Company Name\", \"\")),\n                                    \"Location\": job.get(\"Location\", \"\"),\n                                    \"Application Link\": link,\n                                    \"ATS Platform\": ats_type,\n                                    \"Job Location\": job.get(\"Job Location\", \"\"),\n                                    \"Job Description\": job.get(\"Job Description\", \"\")\n                                }\n                                all_jobs.append(normalized_job)\n                                if \"WORKDAY\" in ats_type.upper():\n                                    workday_count += 1\n                                else:\n                                    easy_ats_count += 1\n                except Exception as e:\n                    print(f\"\342\232\240\357\270\217 Could not read Excel file {file_name}: {e}\")\n            \n            print(f\"\360\237\247\240 Resumed from Excel: Workday={workday_count}/{MAX_WORKDAY_JOBS} | Easy ATS={easy_ats_count}/{MAX_EASY_ATS_JOBS} | Total={len(all_jobs)}/{MAX_TOTAL_JOBS}\")\n\n        # Recover from live saves\n        search_pattern_xlsx_live = os.path.join(OUTPUT_FOLDER, f\"live_saved_jobs_{CANDIDATE_NAME}_*.xlsx\")\n        search_pattern_csv = os.path.join(OUTPUT_FOLDER, f\"LIVE_SAVE_{CANDIDATE_NAME}_*.csv\")\n        \n        existing_xlsx_lives = glob.glob(search_pattern_xlsx_live)\n        existing_csvs = glob.glob(search_pattern_csv)\n        \n        recovery_files = [(f, \"xlsx\") for f in existing_xlsx_lives] + [(f, \"csv\") for f in existing_csvs]\n        \n        if recovery_files:\n            for file_path, file_type in recovery_files:\n                try:\n                    if file_type == \"xlsx\":\n                        df_live = pd.read_excel(file_path)\n                    else:\n                        df_live = pd.read_csv(file_path)\n                        \n                    live_jobs = df_live.to_dict(\'records\')\n                    recovered_count = 0\n                    for job in live_jobs:\n                        link = str(job.get(\"Application Link\", job.get(\"Job URL\", \"\")))\n                        company = str(job.get(\"Company\", job.get(\"Company Name\", \"\"))).strip().lower()\n                        ats_type = str(job.get(\"ATS Platform\", job.get(\"Platform\", \"\")))\n                        if link and link not in seen_links:\n                            seen_links.add(link)\n                            if company:\n                                seen_companies.add(company)\n                            normalized_job = {\n                                \"Role\": job.get(\"Role\", job.get(\"Job Title\", \"\")),\n                                \"Company\": job.get(\"Company\", job.get(\"Company Name\", \"\")),\n                                \"Location\": job.get(\"Location\", \"\"),\n                                \"Application Link\": link,\n                                \"ATS Platform\": ats_type,\n                                \"Job Location\": job.get(\"Job Location\", \"\"),\n                                \"Job Description\": job.get(\"Job Description\", \"\")\n                            }\n                            all_jobs.append(normalized_job)\n                            if \"WORKDAY\" in ats_type.upper():\n                                workday_count += 1\n                            else:\n                                easy_ats_count += 1\n                            recovered_count += 1\n                    if recovered_count > 0:\n                        print(f\"\360\237\223\245 Recovered {recovered_count} job(s) from live save: {os.path.basename(file_path)}\")\n                except Exception as e:\n                    print(f\"\342\232\240\357\270\217 Could not read recovery file {os.path.basename(file_path)}: {e}\")\n\n        timestamp = datetime.now().strftime(\'%Y-%m-%d_%H-%M-%S\')\n        live_xlsx_path = os.path.join(OUTPUT_FOLDER, f\"live_saved_jobs_{CANDIDATE_NAME}_{timestamp}.xlsx\")\n        pd.DataFrame(columns=[\"Role\", \"Company\", \"Location\", \"Application Link\", \"ATS Platform\", \"Job Location\", \"Job Description\"]).to_excel(live_xlsx_path, index=False)\n\n        for title in JOB_TITLES:\n            if len(all_jobs) >= MAX_TOTAL_JOBS:\n                break\n           \n            start_offset = 0\n            while start_offset <= 500:\n                if len(all_jobs) >= MAX_TOTAL_JOBS:\n                    break\n\n                current_page_num = int(start_offset / 25) + 1\n                print(f\"\\n\360\237\224\215 Searching for: {title} (Page {current_page_num}) [Workday: {workday_count}/{MAX_WORKDAY_JOBS} | Easy ATS: {easy_ats_count}/{MAX_EASY_ATS_JOBS}]\")\n               \n                safe_title = urllib.parse.quote(title)\n                search_url = BASE_URL.format(keyword=safe_title, start_offset=start_offset)\n               \n                try:\n                    await page.goto(search_url, timeout=30000, wait_until=\"domcontentloaded\")\n                    await page.wait_for_timeout(2500)\n                    try:\n                        panel = page.locator(\".jobs-search-results-list\")\n                        if await panel.count() > 0:\n                            await panel.first.hover()\n                            for _ in range(4):\n                                await page.mouse.wheel(0, 1500)\n                                await page.wait_for_timeout(600)\n                    except Exception:\n                        pass\n                except Exception as e:\n                    print(f\"\342\232\240\357\270\217 Error loading search page: {e}\")\n                    start_offset += 25\n                    continue\n\n                try:\n                    job_cards = await page.locator(\"li[data-occludable-job-id], li.jobs-search-results__list-item, li.scaffold-layout__list-item\").all()\n                except Exception:\n                    break\n               \n                if len(job_cards) == 0:\n                    print(\"   -> No more jobs found.\")\n                    break\n               \n                for card in job_cards:\n                    if len(all_jobs) >= MAX_TOTAL_JOBS:\n                        break\n\n                    try:\n                        await card.scroll_into_view_if_needed()\n                        card_text = await card.inner_text()\n                        card_lower = card_text.lower()\n                       \n                        if \"easy apply\" in card_lower or \"reposted\" in card_lower or \"repost\" in card_lower:\n                            continue\n                       \n                        applicant_match = re.search(r\'(\\d+)\\s+applicant\', card_lower)\n                        if applicant_match:\n                            if int(applicant_match.group(1)) >= 50:\n                                continue\n\n                        role_loc = card.locator(\".job-card-list__title, .artdeco-entity-lockup__title, strong\")\n                        company_loc = card.locator(\".job-card-container__primary-description, .artdeco-entity-lockup__subtitle\")\n                        location_loc = card.locator(\".job-card-container__metadata-item, .artdeco-entity-lockup__caption\")\n                        link_loc = card.locator(\"a[href*=\'/jobs/view/\'], a.job-card-container__link\")\n\n                        if await link_loc.count() == 0:\n                            continue\n                        \n                        role = await role_loc.first.inner_text()\n                        company = await company_loc.first.inner_text()\n                        location = await location_loc.first.inner_text()\n                        link = await link_loc.first.get_attribute(\"href\")\n                       \n                        scraped_company_clean = company.strip().lower()\n                        if any(blocked in scraped_company_clean for blocked in BLOCKED_COMPANIES):\n                            continue\n                        if scraped_company_clean in seen_companies:\n                            continue\n\n                        scraped_location_clean = location.strip().lower()\n                        valid_us_states = [\", \" + code for code in [\"al\", \"ak\", \"az\", \"ar\", \"ca\", \"co\", \"ct\", \"de\", \"fl\", \"ga\", \"hi\", \"id\", \"il\", \"in\", \"ia\", \"ks\", \"ky\", \"la\", \"me\", \"md\", \"ma\", \"mi\", \"mn\", \"ms\", \"mo\", \"mt\", \"ne\", \"nv\", \"nh\", \"nj\", \"nm\", \"ny\", \"nc\", \"nd\", \"oh\", \"ok\", \"or\", \"pa\", \"ri\", \"sc\", \"sd\", \"tn\", \"tx\", \"ut\", \"vt\", \"va\", \"wa\", \"wv\", \"wi\", \"wy\", \"dc\"]]\n                        is_us = \"united states\" in scraped_location_clean or any(s in scraped_location_clean for s in valid_us_states) or \"area\" in scraped_location_clean\n                        if not is_us:\n                            continue\n\n                        full_link = f\"https://www.linkedin.com{link.split(\'?\')[0]}\" if link.startswith(\"/\") else link.split(\"?\")[0]\n                        if full_link in seen_links:\n                            continue\n\n                        card_time_str = \"\"\n                        try:\n                            card_time_loc = card.locator(\".job-card-container__listed-time, time, .job-card-list__footer-item\")\n                            if await card_time_loc.count() > 0:\n                                card_time_str = (await card_time_loc.first.inner_text()).strip()\n                        except Exception:\n                            pass\n                            \n                        if card_time_str and not is_posted_time_within_12_hours(card_time_str):\n                            continue\n\n                        await link_loc.first.click()\n                        await page.wait_for_timeout(800)\n                        \n                        detail_time_str = \"\"\n                        try:\n                            detail_time_loc = page.locator(\".jobs-unified-top-card__posted-date, [class*=\'posted-date\']\")\n                            if await detail_time_loc.count() > 0:\n                                detail_time_str = (await detail_time_loc.first.inner_text()).strip()\n                        except Exception:\n                            pass\n                            \n                        job_time_str = detail_time_str if detail_time_str else card_time_str\n                        if not is_posted_time_within_12_hours(job_time_str):\n                            continue\n                       \n                        jd_locator = page.locator(\"#job-details, .jobs-description__content\")\n                        if await jd_locator.count() > 0:\n                            jd_text = await jd_locator.first.inner_text()\n                        else:\n                            jd_text = \"Job description could not be loaded.\"\n\n                        jd_lower = jd_text.lower()\n                        if \"no longer accepting\" in jd_lower or \"closed\" in card_lower or \"reposted\" in jd_lower:\n                            continue\n\n                        if any(term in jd_lower for term in [\"security clearance\", \"active clearance\", \"ts/sci\", \"secret clearance\"]):\n                            continue\n\n                        external_url = await resolve_external_apply_url(context, page, link_loc)\n                        if not external_url:\n                            external_url = full_link\n\n                        ats_type = classify_ats_url(external_url, jd_text)\n                        workplace_type = await detect_workplace_type(page, card_text)\n\n                        if ats_type == \"WORKDAY\":\n                            if workday_count >= MAX_WORKDAY_JOBS:\n                                continue\n                            workday_count += 1\n                        else:\n                            if easy_ats_count >= MAX_EASY_ATS_JOBS:\n                                continue\n                            easy_ats_count += 1\n\n                        seen_companies.add(scraped_company_clean)\n                        seen_links.add(full_link)\n\n                        new_job = {\n                            \"Role\": role.strip(),\n                            \"Company\": company.strip(),\n                            \"Location\": location.strip().split(\"\\n\")[0],\n                            \"Application Link\": external_url,\n                            \"ATS Platform\": ats_type,\n                            \"Job Location\": workplace_type,\n                            \"Job Description\": jd_text.strip()\n                        }\n                       \n                        all_jobs.append(new_job)\n                        try:\n                            if os.path.exists(live_xlsx_path):\n                                df_temp = pd.read_excel(live_xlsx_path)\n                                df_temp = pd.concat([df_temp, pd.DataFrame([new_job])], ignore_index=True)\n                            else:\n                                df_temp = pd.DataFrame([new_job])\n                            df_temp.to_excel(live_xlsx_path, index=False)\n                        except Exception as e:\n                            print(f\"\342\232\240\357\270\217 Warning: Could not write live save: {e}\")\n\n                        print(f\"   [{len(all_jobs)}/{MAX_TOTAL_JOBS}] \342\234\205 Collected ({ats_type}): \'{role.strip()}\' at \'{company.strip()}\'\")\n\n                    except Exception:\n                        continue\n\n                start_offset += 25\n\n        print(\"\\nClosing browser...\")\n        await context.close()\n       \n        if all_jobs:\n            processed_jobs = []\n            for job in all_jobs:\n                ats_platform = job.get(\"ATS Platform\", \"EASY_ATS\")\n                platform_mapped = \"LinkedIn\"\n                if \"WORKDAY\" in str(ats_platform).upper():\n                    platform_mapped = \"Workday\"\n                elif \"GREENHOUSE\" in str(ats_platform).upper():\n                    platform_mapped = \"Greenhouse\"\n                elif \"LEVER\" in str(ats_platform).upper():\n                    platform_mapped = \"Lever\"\n                elif \"ASHBY\" in str(ats_platform).upper():\n                    platform_mapped = \"Ashby\"\n                elif \"WORKABLE\" in str(ats_platform).upper():\n                    platform_mapped = \"Workable\"\n                elif \"SMARTRECRUITERS\" in str(ats_platform).upper():\n                    platform_mapped = \"SmartRecruiters\"\n                elif \"BAMBOOHR\" in str(ats_platform).upper():\n                    platform_mapped = \"BambooHR\"\n                else:\n                    app_url = job.get(\"Application Link\", \"\")\n                    if \"linkedin.com\" in str(app_url):\n                        platform_mapped = \"LinkedIn\"\n                    else:\n                        platform_mapped = \"Company Website\"\n                \n                job_location = job.get(\"Job Location\", \"On-site\")\n                processed_jobs.append({\n                    \"Company\": job.get(\"Company\", \"\"),\n                    \"Location\": job.get(\"Location\", \"\"),\n                    \"Role\": job.get(\"Role\", \"\"),\n                    \"Job Location\": job_location,\n                    \"Platform\": platform_mapped,\n                    \"Job URL\": job.get(\"Application Link\", \"\"),\n                    \"Job Description\": job.get(\"Job Description\", \"\")\n                })\n            \n            df_processed = pd.DataFrame(processed_jobs)\n            df_processed.drop_duplicates(subset=[\"Job URL\"], inplace=True)\n            \n            final_filename = os.path.join(OUTPUT_FOLDER, today_filename)\n            try:\n                df_processed.to_excel(final_filename, index=False)\n            except Exception as e:\n                print(f\"\342\232\240\357\270\217 Warning: Could not write final Excel file: {e}\")\n                print(\"   (This usually happens if you have the Excel file open in another program. We will proceed anyway.)\")\n           \n            if os.path.exists(live_xlsx_path):\n                try:\n                    os.remove(live_xlsx_path)\n                except Exception:\n                    pass\n               \n            print(f\"\\n\360\237\216\211 Success! Collected {len(df_processed)} jobs:\\n\360\237\221\211 {final_filename}\")\n        else:\n            print(\"No new jobs found matching requirements.\")\n\n        # Launch the resume tailoring pipeline\n        if not getattr(args, \"scrape_only\", False):\n            try:\n                from run_tailor import run_tailoring_pipeline\n                print(\"\\n\360\237\232\200 Scraping complete! Launching Resume Tailoring Pipeline...\")\n                await run_tailoring_pipeline(candidate=CANDIDATE_NAME)\n            except Exception as e:\n                print(f\"\342\232\240\357\270\217 Warning: Could not automatically launch resume customizer: {e}\")\n        else:\n            print(\"\\n\342\217\271\357\270\217 Scrape-only mode active. Skipping resume customizer.\")\n\nif __name__ == \"__main__\":\n    asyncio.run(scrape_linkedin_jobs())\n\n\n Easy Apply means not LinkedIn Easy Apply,This is the code which I previously have been using it. I am sharing it with you. Can you just see and tell me whether can you segregate Workday? Like while searching jobs can you open the LinkedIn link to check whether it is Workday or whether it is EasyApply? Can you do that?"
    items {
      text: "import asyncio\nimport os\nimport glob\nimport sys\nimport pandas as pd\nimport urllib.parse\nfrom playwright.async_api import async_playwright\nfrom datetime import datetime\nimport re\nimport argparse\nimport json\n\n# Force UTF-8 encoding for standard streams to prevent UnicodeEncodeError when printing emojis on Windows\nfor stream in (sys.stdout, sys.stderr):\n    if stream and hasattr(stream, \'reconfigure\'):\n        try:\n            stream.reconfigure(encoding=\'utf-8\', errors=\'replace\')\n        except Exception:\n            pass\n\n# ==================== ARGUMENT PARSING ====================\nparser = argparse.ArgumentParser(description=\"Config-Driven LinkedIn Jobs Scraper Bot\")\nparser.add_argument(\"--candidate\", type=str, required=True, help=\"Candidate name from profiles.json (e.g. Vinay, Sumit, Shiva)\")\nparser.add_argument(\"--workday\", type=int, default=None, help=\"Override Max Workday Jobs limit\")\nparser.add_argument(\"--easy\", type=int, default=None, help=\"Override Max Easy Apply ATS Jobs limit\")\nparser.add_argument(\"--scrape-only\", action=\"store_true\", help=\"Scrape jobs and write output Excel file without starting the resume customizer\")\nargs, unknown = parser.parse_known_args()\n\nCANDIDATE_NAME = args.candidate.strip()\n\n# Load profiles.json configuration\nCONFIG_PATH = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"profiles.json\")\nif not os.path.exists(CONFIG_PATH):\n    print(f\"\342\235\214 Error: Central configuration file profiles.json not found at: {CONFIG_PATH}\")\n    sys.exit(1)\n\nwith open(CONFIG_PATH, \'r\', encoding=\'utf-8\') as f:\n    PROFILES = json.load(f)\n\nif CANDIDATE_NAME not in PROFILES:\n    print(f\"\342\235\214 Error: Candidate \'{CANDIDATE_NAME}\' not found in profiles.json. Available candidates: {list(PROFILES.keys())}\")\n    sys.exit(1)\n\nCANDIDATE_CONFIG = PROFILES[CANDIDATE_NAME]\n\n# ==================== CONFIGURATION ====================\nWINDOWS_USERNAME = os.environ.get(\"USERNAME\", \"shrey\")\nOUTPUT_FOLDER = rf\"C:\\Users\\{WINDOWS_USERNAME}\\Documents\\LinkedIn_Jobs\"\n\n# Resolve limits from arguments or config file\nMAX_WORKDAY_JOBS = args.workday if args.workday is not None else CANDIDATE_CONFIG.get(\"max_workday_jobs\", 10)\nMAX_EASY_ATS_JOBS = args.easy if args.easy is not None else CANDIDATE_CONFIG.get(\"max_easy_ats_jobs\", 65)\nMAX_TOTAL_JOBS = MAX_WORKDAY_JOBS + MAX_EASY_ATS_JOBS\n\nJOB_TITLES = CANDIDATE_CONFIG.get(\"search_keywords\", [])\nBOT_PROFILE_DIR = CANDIDATE_CONFIG.get(\"linkedin_profile\")\n\n# \360\237\232\253 BLACKLISTED COMPANIES (Instantly Skipped for Speed)\nBLOCKED_COMPANIES = [\n    \"pinnacle\", \"google\", \"dice\", \"tcs\", \"tata consultancy\", \"ladder\", \"jobright\",\n    \"netrolynx\", \"jack & jill\", \"jack and jill\", \"chatgpt\", \"openai\", \"microsoft\",\n    \"fetchojobs\", \"fetch\", \"sundayy\", \"accenture\", \"deloitte\", \"dataannotation\",\n    \"haystack\", \"hackajob\", \"accenture federal services\"\n]\n\n# \360\237\225\222 f_TPR=r43200 sets searching strictly to the past 12 hours\nBASE_URL = \"https://www.linkedin.com/jobs/search/?f_TPR=r43200&f_JT=F&location=United%20States&keywords={keyword}&sortBy=DD&start={start_offset}\"\n\n# =======================================================\n# ATS PLATFORM DETECTOR\n# =======================================================\ndef classify_ats_url(url: str, page_content: str = \"\") -> str:\n    url_lower = url.lower()\n    content_lower = page_content.lower()\n\n    workday_patterns = [\"myworkdayjobs.com\", \"workday.com\", \"wd1.myworkdayjobs\", \"wd3.myworkdayjobs\", \"wd5.myworkdayjobs\", \"workday\"]\n    if any(p in url_lower for p in workday_patterns) or \"myworkdayjobs\" in content_lower:\n        return \"WORKDAY\"\n\n    if any(p in url_lower for p in [\"greenhouse.io\", \"gh_jid=\", \"gh_src=\"]) or \"grnhse_app\" in content_lower:\n        return \"EASY_ATS (Greenhouse)\"\n    if \"ashbyhq.com\" in url_lower or \"ashby-job-posting\" in content_lower:\n        return \"EASY_ATS (Ashby)\"\n    if \"lever.co\" in url_lower or \"lever-job-posting\" in content_lower:\n        return \"EASY_ATS (Lever)\"\n    if any(p in url_lower for p in [\"craft.co\", \"craftweave\"]):\n        return \"EASY_ATS (Craftweave)\"\n    if \"workable.com\" in url_lower:\n        return \"EASY_ATS (Workable)\"\n    if \"smartrecruiters.com\" in url_lower:\n        return \"EASY_ATS (SmartRecruiters)\"\n    if \"bamboohr.com\" in url_lower:\n        return \"EASY_ATS (BambooHR)\"\n\n    return \"EASY_ATS\"\n\n# =======================================================\n# WORKPLACE TYPE DETECTOR\n# =======================================================\nasync def detect_workplace_type(page, card_text: str) -> str:\n    card_lower = card_text.lower()\n    try:\n        wp_loc = page.locator(\".jobs-unified-top-card__workplace-type, .jobs-description-style__workplace-type\")\n        if await wp_loc.count() > 0:\n            text = (await wp_loc.first.inner_text()).strip()\n            if text:\n                text_lower = text.lower()\n                if \"remote\" in text_lower:\n                    return \"Remote\"\n                elif \"hybrid\" in text_lower:\n                    return \"Hybrid\"\n                elif \"on-site\" in text_lower or \"onsite\" in text_lower:\n                    return \"On-site\"\n                return text\n    except Exception:\n        pass\n\n    if \"remote\" in card_lower:\n        return \"Remote\"\n    elif \"hybrid\" in card_lower:\n        return \"Hybrid\"\n    elif \"on-site\" in card_lower or \"onsite\" in card_lower:\n        return \"On-site\"\n    return \"On-site\"\n\ndef is_posted_time_within_12_hours(time_str: str) -> bool:\n    time_str = time_str.lower().strip()\n    if not time_str:\n        return True\n    if \"yesterday\" in time_str:\n        return False\n    match = re.search(r\'(\\d+)\\s*([a-z]+)\', time_str)\n    if match:\n        value = int(match.group(1))\n        unit = match.group(2)\n        if unit in [\"m\", \"min\", \"minute\", \"minutes\"]:\n            return True\n        if unit in [\"h\", \"hr\", \"hrs\", \"hour\", \"hours\"]:\n            return value <= 12\n        if unit in [\"d\", \"day\", \"days\", \"w\", \"wk\", \"week\", \"weeks\", \"mo\", \"month\", \"months\", \"y\", \"yr\", \"year\", \"years\"]:\n            return False\n    if any(k in time_str for k in [\"day\", \"week\", \"month\", \"year\", \"yesterday\"]):\n        return False\n    return True\n\nasync def resolve_external_apply_url(context, page, link_loc) -> str:\n    final_url = \"\"\n    try:\n        apply_btn = page.locator(\"button.jobs-apply-button, a.jobs-apply-button, button[data-job-id]\")\n        if await apply_btn.count() > 0:\n            btn_text = await apply_btn.first.inner_text()\n            if \"easy apply\" in btn_text.lower():\n                return \"\"\n            new_page = None\n            try:\n                async with context.expect_page(timeout=4000) as page_info:\n                    await apply_btn.first.click()\n                new_page = await page_info.value\n            except Exception:\n                modal_selectors = [\n                    \"div[role=\'dialog\'] button:has-text(\'Continue\')\",\n                    \"div[role=\'dialog\'] a:has-text(\'Continue\')\",\n                    \"div[role=\'dialog\'] button:has-text(\'Apply\')\",\n                    \"button:has-text(\'Continue\')\",\n                    \"button:has-text(\'Go to website\')\",\n                    \".jobs-apply-button--modal\"\n                ]\n                for selector in modal_selectors:\n                    modal_btn = page.locator(selector)\n                    if await modal_btn.count() > 0 and await modal_btn.first.is_visible():\n                        try:\n                            async with context.expect_page(timeout=6000) as page_info2:\n                                await modal_btn.first.click()\n                            new_page = await page_info2.value\n                            break\n                        except Exception:\n                            pass\n\n            if new_page:\n                await new_page.wait_for_load_state(\"domcontentloaded\", timeout=12000)\n                await new_page.wait_for_timeout(2000)\n                final_url = new_page.url\n                await new_page.close()\n    except Exception as e:\n        print(f\"   \342\232\240\357\270\217 Error resolving external URL: {e}\")\n\n    if not final_url:\n        try:\n            href = await link_loc.first.get_attribute(\"href\")\n            if href:\n                final_url = f\"https://www.linkedin.com{href.split(\'?\')[0]}\" if href.startswith(\"/\") else href.split(\"?\")[0]\n        except Exception:\n            pass\n\n    return final_url\n\nasync def scrape_linkedin_jobs():\n    # If scraping is disabled for this candidate (e.g. Sumit reads Vinay\'s output)\n    if not CANDIDATE_CONFIG.get(\"scraping_enabled\", True):\n        scraped_source = CANDIDATE_CONFIG.get(\"read_scraped_from\")\n        print(f\"\342\204\271\357\270\217 Scraping disabled for \'{CANDIDATE_NAME}\'. Reading scraped jobs from \'{scraped_source}\' instead.\")\n        \n        # Directly launch tailoring\n        try:\n            from run_tailor import run_tailoring_pipeline\n            print(f\"\\n\360\237\232\200 Launching Resume Tailoring Pipeline directly for {CANDIDATE_NAME}...\")\n            await run_tailoring_pipeline(candidate=CANDIDATE_NAME)\n        except Exception as e:\n            print(f\"\342\235\214 Tailoring pipeline launch failed: {e}\")\n        return\n\n    if not os.path.exists(OUTPUT_FOLDER):\n        os.makedirs(OUTPUT_FOLDER)\n    if not os.path.exists(BOT_PROFILE_DIR):\n        os.makedirs(BOT_PROFILE_DIR)\n\n    async with async_playwright() as p:\n        print(f\"\360\237\232\200 Launching Scraper Bot for \'{CANDIDATE_NAME}\' (Target: {MAX_WORKDAY_JOBS} Workday + {MAX_EASY_ATS_JOBS} Easy ATS = {MAX_TOTAL_JOBS} total)...\")\n       \n        context = await p.chromium.launch_persistent_context(\n            user_data_dir=BOT_PROFILE_DIR,\n            channel=\"chrome\",\n            headless=False,  \n            slow_mo=150,\n            ignore_default_args=[\"--enable-automation\"],\n            args=[\"--disable-extensions\", \"--disable-blink-features=AutomationControlled\"]\n        )\n       \n        page = context.pages[0] if context.pages else await context.new_page()\n       \n        print(\"Checking login status...\")\n        try:\n            await page.goto(\"https://www.linkedin.com/\", timeout=60000, wait_until=\"domcontentloaded\")\n            await page.wait_for_timeout(1500)\n        except Exception as e:\n            print(f\"\342\235\214 Failed to load LinkedIn homepage. Error: {e}\")\n            await context.close()\n            return\n       \n        if \"feed\" not in page.url and \"mynetwork\" not in page.url:\n            print(\"\\n\" + \"=\"*60)\n            print(\"\360\237\233\221 FIRST TIME SETUP REQUIRED \360\237\233\221\")\n            print(f\"Please log into LinkedIn manually for profile \'{CANDIDATE_NAME}\'.\")\n            print(\"=\"*60 + \"\\n\")\n            try:\n                await page.wait_for_url(\"**/feed/**\", timeout=300000)\n                print(\"\342\234\205 Login successful!\")\n            except Exception:\n                print(\"\342\235\214 Did not detect login. Closing script.\")\n                await context.close()\n                return\n        else:\n            print(\"\342\234\205 Bot is logged in!\")\n\n        all_jobs = []\n        seen_links = set()\n        seen_companies = set()\n        \n        workday_count = 0\n        easy_ats_count = 0\n       \n        today_str = datetime.now().strftime(\'%Y-%m-%d\')\n        today_filename = f\"{CANDIDATE_NAME}_LinkedIn_Jobs_{today_str}.xlsx\"\n        \n        # Load from existing files for global duplicate checks\n        existing_xlsx = glob.glob(os.path.join(OUTPUT_FOLDER, \"*.xlsx\"))\n        existing_xlsx = [\n            f for f in existing_xlsx \n            if \"_with_jd\" not in f \n            and \"live_saved\" not in f \n            and not os.path.basename(f).startswith(\"~$\")\n        ]\n        \n        if existing_xlsx:\n            for xlsx_file in existing_xlsx:\n                file_name = os.path.basename(xlsx_file)\n                is_today = file_name == today_filename\n                try:\n                    df_existing = pd.read_excel(xlsx_file)\n                    excel_jobs = df_existing.to_dict(\'records\')\n                    for job in excel_jobs:\n                        link = str(job.get(\"Job URL\", job.get(\"Application Link\", \"\")))\n                        company = str(job.get(\"Company\", job.get(\"Company Name\", \"\"))).strip().lower()\n                        ats_type = str(job.get(\"Platform\", job.get(\"ATS Platform\", \"\")))\n                        \n                        if link and link not in seen_links:\n                            seen_links.add(link)\n                            if company:\n                                seen_companies.add(company)\n                            if is_today:\n                                normalized_job = {\n                                    \"Role\": job.get(\"Role\", job.get(\"Job Title\", \"\")),\n                                    \"Company\": job.get(\"Company\", job.get(\"Company Name\", \"\")),\n                                    \"Location\": job.get(\"Location\", \"\"),\n                                    \"Application Link\": link,\n                                    \"ATS Platform\": ats_type,\n                                    \"Job Location\": job.get(\"Job Location\", \"\"),\n                                    \"Job Description\": job.get(\"Job Description\", \"\")\n                                }\n                                all_jobs.append(normalized_job)\n                                if \"WORKDAY\" in ats_type.upper():\n                                    workday_count += 1\n                                else:\n                                    easy_ats_count += 1\n                except Exception as e:\n                    print(f\"\342\232\240\357\270\217 Could not read Excel file {file_name}: {e}\")\n            \n            print(f\"\360\237\247\240 Resumed from Excel: Workday={workday_count}/{MAX_WORKDAY_JOBS} | Easy ATS={easy_ats_count}/{MAX_EASY_ATS_JOBS} | Total={len(all_jobs)}/{MAX_TOTAL_JOBS}\")\n\n        # Recover from live saves\n        search_pattern_xlsx_live = os.path.join(OUTPUT_FOLDER, f\"live_saved_jobs_{CANDIDATE_NAME}_*.xlsx\")\n        search_pattern_csv = os.path.join(OUTPUT_FOLDER, f\"LIVE_SAVE_{CANDIDATE_NAME}_*.csv\")\n        \n        existing_xlsx_lives = glob.glob(search_pattern_xlsx_live)\n        existing_csvs = glob.glob(search_pattern_csv)\n        \n        recovery_files = [(f, \"xlsx\") for f in existing_xlsx_lives] + [(f, \"csv\") for f in existing_csvs]\n        \n        if recovery_files:\n            for file_path, file_type in recovery_files:\n                try:\n                    if file_type == \"xlsx\":\n                        df_live = pd.read_excel(file_path)\n                    else:\n                        df_live = pd.read_csv(file_path)\n                        \n                    live_jobs = df_live.to_dict(\'records\')\n                    recovered_count = 0\n                    for job in live_jobs:\n                        link = str(job.get(\"Application Link\", job.get(\"Job URL\", \"\")))\n                        company = str(job.get(\"Company\", job.get(\"Company Name\", \"\"))).strip().lower()\n                        ats_type = str(job.get(\"ATS Platform\", job.get(\"Platform\", \"\")))\n                        if link and link not in seen_links:\n                            seen_links.add(link)\n                            if company:\n                                seen_companies.add(company)\n                            normalized_job = {\n                                \"Role\": job.get(\"Role\", job.get(\"Job Title\", \"\")),\n                                \"Company\": job.get(\"Company\", job.get(\"Company Name\", \"\")),\n                                \"Location\": job.get(\"Location\", \"\"),\n                                \"Application Link\": link,\n                                \"ATS Platform\": ats_type,\n                                \"Job Location\": job.get(\"Job Location\", \"\"),\n                                \"Job Description\": job.get(\"Job Description\", \"\")\n                            }\n                            all_jobs.append(normalized_job)\n                            if \"WORKDAY\" in ats_type.upper():\n                                workday_count += 1\n                            else:\n                                easy_ats_count += 1\n                            recovered_count += 1\n                    if recovered_count > 0:\n                        print(f\"\360\237\223\245 Recovered {recovered_count} job(s) from live save: {os.path.basename(file_path)}\")\n                except Exception as e:\n                    print(f\"\342\232\240\357\270\217 Could not read recovery file {os.path.basename(file_path)}: {e}\")\n\n        timestamp = datetime.now().strftime(\'%Y-%m-%d_%H-%M-%S\')\n        live_xlsx_path = os.path.join(OUTPUT_FOLDER, f\"live_saved_jobs_{CANDIDATE_NAME}_{timestamp}.xlsx\")\n        pd.DataFrame(columns=[\"Role\", \"Company\", \"Location\", \"Application Link\", \"ATS Platform\", \"Job Location\", \"Job Description\"]).to_excel(live_xlsx_path, index=False)\n\n        for title in JOB_TITLES:\n            if len(all_jobs) >= MAX_TOTAL_JOBS:\n                break\n           \n            start_offset = 0\n            while start_offset <= 500:\n                if len(all_jobs) >= MAX_TOTAL_JOBS:\n                    break\n\n                current_page_num = int(start_offset / 25) + 1\n                print(f\"\\n\360\237\224\215 Searching for: {title} (Page {current_page_num}) [Workday: {workday_count}/{MAX_WORKDAY_JOBS} | Easy ATS: {easy_ats_count}/{MAX_EASY_ATS_JOBS}]\")\n               \n                safe_title = urllib.parse.quote(title)\n                search_url = BASE_URL.format(keyword=safe_title, start_offset=start_offset)\n               \n                try:\n                    await page.goto(search_url, timeout=30000, wait_until=\"domcontentloaded\")\n                    await page.wait_for_timeout(2500)\n                    try:\n                        panel = page.locator(\".jobs-search-results-list\")\n                        if await panel.count() > 0:\n                            await panel.first.hover()\n                            for _ in range(4):\n                                await page.mouse.wheel(0, 1500)\n                                await page.wait_for_timeout(600)\n                    except Exception:\n                        pass\n                except Exception as e:\n                    print(f\"\342\232\240\357\270\217 Error loading search page: {e}\")\n                    start_offset += 25\n                    continue\n\n                try:\n                    job_cards = await page.locator(\"li[data-occludable-job-id], li.jobs-search-results__list-item, li.scaffold-layout__list-item\").all()\n                except Exception:\n                    break\n               \n                if len(job_cards) == 0:\n                    print(\"   -> No more jobs found.\")\n                    break\n               \n                for card in job_cards:\n                    if len(all_jobs) >= MAX_TOTAL_JOBS:\n                        break\n\n                    try:\n                        await card.scroll_into_view_if_needed()\n                        card_text = await card.inner_text()\n                        card_lower = card_text.lower()\n                       \n                        if \"easy apply\" in card_lower or \"reposted\" in card_lower or \"repost\" in card_lower:\n                            continue\n                       \n                        applicant_match = re.search(r\'(\\d+)\\s+applicant\', card_lower)\n                        if applicant_match:\n                            if int(applicant_match.group(1)) >= 50:\n                                continue\n\n                        role_loc = card.locator(\".job-card-list__title, .artdeco-entity-lockup__title, strong\")\n                        company_loc = card.locator(\".job-card-container__primary-description, .artdeco-entity-lockup__subtitle\")\n                        location_loc = card.locator(\".job-card-container__metadata-item, .artdeco-entity-lockup__caption\")\n                        link_loc = card.locator(\"a[href*=\'/jobs/view/\'], a.job-card-container__link\")\n\n                        if await link_loc.count() == 0:\n                            continue\n                        \n                        role = await role_loc.first.inner_text()\n                        company = await company_loc.first.inner_text()\n                        location = await location_loc.first.inner_text()\n                        link = await link_loc.first.get_attribute(\"href\")\n                       \n                        scraped_company_clean = company.strip().lower()\n                        if any(blocked in scraped_company_clean for blocked in BLOCKED_COMPANIES):\n                            continue\n                        if scraped_company_clean in seen_companies:\n                            continue\n\n                        scraped_location_clean = location.strip().lower()\n                        valid_us_states = [\", \" + code for code in [\"al\", \"ak\", \"az\", \"ar\", \"ca\", \"co\", \"ct\", \"de\", \"fl\", \"ga\", \"hi\", \"id\", \"il\", \"in\", \"ia\", \"ks\", \"ky\", \"la\", \"me\", \"md\", \"ma\", \"mi\", \"mn\", \"ms\", \"mo\", \"mt\", \"ne\", \"nv\", \"nh\", \"nj\", \"nm\", \"ny\", \"nc\", \"nd\", \"oh\", \"ok\", \"or\", \"pa\", \"ri\", \"sc\", \"sd\", \"tn\", \"tx\", \"ut\", \"vt\", \"va\", \"wa\", \"wv\", \"wi\", \"wy\", \"dc\"]]\n                        is_us = \"united states\" in scraped_location_clean or any(s in scraped_location_clean for s in valid_us_states) or \"area\" in scraped_location_clean\n                        if not is_us:\n                            continue\n\n                        full_link = f\"https://www.linkedin.com{link.split(\'?\')[0]}\" if link.startswith(\"/\") else link.split(\"?\")[0]\n                        if full_link in seen_links:\n                            continue\n\n                        card_time_str = \"\"\n                        try:\n                            card_time_loc = card.locator(\".job-card-container__listed-time, time, .job-card-list__footer-item\")\n                            if await card_time_loc.count() > 0:\n                                card_time_str = (await card_time_loc.first.inner_text()).strip()\n                        except Exception:\n                            pass\n                            \n                        if card_time_str and not is_posted_time_within_12_hours(card_time_str):\n                            continue\n\n                        await link_loc.first.click()\n                        await page.wait_for_timeout(800)\n                        \n                        detail_time_str = \"\"\n                        try:\n                            detail_time_loc = page.locator(\".jobs-unified-top-card__posted-date, [class*=\'posted-date\']\")\n                            if await detail_time_loc.count() > 0:\n                                detail_time_str = (await detail_time_loc.first.inner_text()).strip()\n                        except Exception:\n                            pass\n                            \n                        job_time_str = detail_time_str if detail_time_str else card_time_str\n                        if not is_posted_time_within_12_hours(job_time_str):\n                            continue\n                       \n                        jd_locator = page.locator(\"#job-details, .jobs-description__content\")\n                        if await jd_locator.count() > 0:\n                            jd_text = await jd_locator.first.inner_text()\n                        else:\n                            jd_text = \"Job description could not be loaded.\"\n\n                        jd_lower = jd_text.lower()\n                        if \"no longer accepting\" in jd_lower or \"closed\" in card_lower or \"reposted\" in jd_lower:\n                            continue\n\n                        if any(term in jd_lower for term in [\"security clearance\", \"active clearance\", \"ts/sci\", \"secret clearance\"]):\n                            continue\n\n                        external_url = await resolve_external_apply_url(context, page, link_loc)\n                        if not external_url:\n                            external_url = full_link\n\n                        ats_type = classify_ats_url(external_url, jd_text)\n                        workplace_type = await detect_workplace_type(page, card_text)\n\n                        if ats_type == \"WORKDAY\":\n                            if workday_count >= MAX_WORKDAY_JOBS:\n                                continue\n                            workday_count += 1\n                        else:\n                            if easy_ats_count >= MAX_EASY_ATS_JOBS:\n                                continue\n                            easy_ats_count += 1\n\n                        seen_companies.add(scraped_company_clean)\n                        seen_links.add(full_link)\n\n                        new_job = {\n                            \"Role\": role.strip(),\n                            \"Company\": company.strip(),\n                            \"Location\": location.strip().split(\"\\n\")[0],\n                            \"Application Link\": external_url,\n                            \"ATS Platform\": ats_type,\n                            \"Job Location\": workplace_type,\n                            \"Job Description\": jd_text.strip()\n                        }\n                       \n                        all_jobs.append(new_job)\n                        try:\n                            if os.path.exists(live_xlsx_path):\n                                df_temp = pd.read_excel(live_xlsx_path)\n                                df_temp = pd.concat([df_temp, pd.DataFrame([new_job])], ignore_index=True)\n                            else:\n                                df_temp = pd.DataFrame([new_job])\n                            df_temp.to_excel(live_xlsx_path, index=False)\n                        except Exception as e:\n                            print(f\"\342\232\240\357\270\217 Warning: Could not write live save: {e}\")\n\n                        print(f\"   [{len(all_jobs)}/{MAX_TOTAL_JOBS}] \342\234\205 Collected ({ats_type}): \'{role.strip()}\' at \'{company.strip()}\'\")\n\n                    except Exception:\n                        continue\n\n                start_offset += 25\n\n        print(\"\\nClosing browser...\")\n        await context.close()\n       \n        if all_jobs:\n            processed_jobs = []\n            for job in all_jobs:\n                ats_platform = job.get(\"ATS Platform\", \"EASY_ATS\")\n                platform_mapped = \"LinkedIn\"\n                if \"WORKDAY\" in str(ats_platform).upper():\n                    platform_mapped = \"Workday\"\n                elif \"GREENHOUSE\" in str(ats_platform).upper():\n                    platform_mapped = \"Greenhouse\"\n                elif \"LEVER\" in str(ats_platform).upper():\n                    platform_mapped = \"Lever\"\n                elif \"ASHBY\" in str(ats_platform).upper():\n                    platform_mapped = \"Ashby\"\n                elif \"WORKABLE\" in str(ats_platform).upper():\n                    platform_mapped = \"Workable\"\n                elif \"SMARTRECRUITERS\" in str(ats_platform).upper():\n                    platform_mapped = \"SmartRecruiters\"\n                elif \"BAMBOOHR\" in str(ats_platform).upper():\n                    platform_mapped = \"BambooHR\"\n                else:\n                    app_url = job.get(\"Application Link\", \"\")\n                    if \"linkedin.com\" in str(app_url):\n                        platform_mapped = \"LinkedIn\"\n                    else:\n                        platform_mapped = \"Company Website\"\n                \n                job_location = job.get(\"Job Location\", \"On-site\")\n                processed_jobs.append({\n                    \"Company\": job.get(\"Company\", \"\"),\n                    \"Location\": job.get(\"Location\", \"\"),\n                    \"Role\": job.get(\"Role\", \"\"),\n                    \"Job Location\": job_location,\n                    \"Platform\": platform_mapped,\n                    \"Job URL\": job.get(\"Application Link\", \"\"),\n                    \"Job Description\": job.get(\"Job Description\", \"\")\n                })\n            \n            df_processed = pd.DataFrame(processed_jobs)\n            df_processed.drop_duplicates(subset=[\"Job URL\"], inplace=True)\n            \n            final_filename = os.path.join(OUTPUT_FOLDER, today_filename)\n            try:\n                df_processed.to_excel(final_filename, index=False)\n            except Exception as e:\n                print(f\"\342\232\240\357\270\217 Warning: Could not write final Excel file: {e}\")\n                print(\"   (This usually happens if you have the Excel file open in another program. We will proceed anyway.)\")\n           \n            if os.path.exists(live_xlsx_path):\n                try:\n                    os.remove(live_xlsx_path)\n                except Exception:\n                    pass\n               \n            print(f\"\\n\360\237\216\211 Success! Collected {len(df_processed)} jobs:\\n\360\237\221\211 {final_filename}\")\n        else:\n            print(\"No new jobs found matching requirements.\")\n\n        # Launch the resume tailoring pipeline\n        if not getattr(args, \"scrape_only\", False):\n            try:\n                from run_tailor import run_tailoring_pipeline\n                print(\"\\n\360\237\232\200 Scraping complete! Launching Resume Tailoring Pipeline...\")\n                await run_tailoring_pipeline(candidate=CANDIDATE_NAME)\n            except Exception as e:\n                print(f\"\342\232\240\357\270\217 Warning: Could not automatically launch resume customizer: {e}\")\n        else:\n            print(\"\\n\342\217\271\357\270\217 Scrape-only mode active. Skipping resume customizer.\")\n\nif __name__ == \"__main__\":\n    asyncio.run(scrape_linkedin_jobs())\n\n\n Easy Apply means not LinkedIn Easy Apply,This is the code which I previously have been using it. I am sharing it with you. Can you just see and tell me whether can you segregate Workday? Like while searching jobs can you open the LinkedIn link to check whether it is Workday or whether it is EasyApply? Can you do that?"
